# p2s-harden 2.3.0-dev.5. Self-contained Windows -> Linux SSH launcher.
# No PowerShell modules, Bash, Python or installation needed on the client.
$ErrorActionPreference = 'Stop'
$target = $null
$cliArguments = New-Object 'System.Collections.Generic.List[string]'
$jsonMode = $false
$redactMode = $false
$lang = 'en'

function Message([string]$English, [string]$German) {
    if ($script:lang -eq 'de') { return $German }
    return $English
}

function Write-Failure([string]$Title, [string]$Detail) {
    if ($script:redactMode) {
        $Title = 'P2S-EXEC001'
        $Detail = Message 'Host details omitted; rerun locally without --redact' 'Hostdetails ausgelassen; zur lokalen Diagnose ohne --redact wiederholen'
    }
    if ($script:jsonMode) {
        @{ schema_version = 2; version = '2.3.0-dev.5'; language = $script:lang; redacted = $script:redactMode; exit_code = 2;
           has_open = $false; has_unknown = $true;
           findings = @(@{ id = 'P2S-EXEC001-9773e1e8b98e2493'; rule_id = 'P2S-EXEC001'; resource = 'ssh_transport'; severity = 'unknown';
                           suppressed = $false; remediation = $Detail; status = 'UNKNOWN'; title = $Title; detail = $Detail }); discovery = @{} } | ConvertTo-Json -Depth 5
    } else { [Console]::Error.WriteLine("${Title}: $Detail") }
}

function Quote-Posix([string]$Value) {
    return "'" + $Value.Replace("'", "'\''") + "'"
}

function Quote-Native([string]$Value) {
    # Windows argv quoting, including quotes and trailing backslashes.
    return '"' + (($Value -replace '(\\*)"', '$1$1\"') -replace '(\\+)$', '$1$1') + '"'
}

try {
    $jsonMode = $args -contains '--json'
    $redactMode = $args -contains '--redact'
    for ($i = 0; $i -lt $args.Count; $i++) {
        if ($args[$i] -eq '--lang') {
            if ($i + 1 -ge $args.Count) { throw '--lang requires en or de.' }
            $lang = [string]$args[++$i]
        } elseif ([string]$args[$i] -like '--lang=*') { $lang = ([string]$args[$i]).Substring(7) }
    }
    if ($lang -notin @('en', 'de')) { $lang = 'en'; throw '--lang requires en or de.' }
    for ($i = 0; $i -lt $args.Count; $i++) {
        $argument = [string]$args[$i]
        switch ($argument) {
            '--ssh' {
                if ($null -ne $target -or $i + 1 -ge $args.Count) { throw (Message '--ssh requires exactly one Linux target.' '--ssh braucht genau ein Linux-Ziel.') }
                $target = [string]$args[++$i]
                if ($target -notmatch '^[A-Za-z0-9_][A-Za-z0-9_.@:-]*$' -and $target -notmatch '^([A-Za-z0-9_.-]+@)?\[[0-9A-Fa-f:.%]+\]$') { throw (Message 'Invalid SSH target.' 'Ungültiges SSH-Ziel.') }
            }
            '--help' {
                if ($lang -eq 'en') {
                    @'
p2s-harden 2.3.0-dev.5 - Windows -> Linux, directly over OpenSSH

  .\p2s-harden.ps1 --ssh root@SERVER              Discover and audit
  .\p2s-harden.ps1 --ssh root@SERVER --doctor     Explain prerequisites
  .\p2s-harden.ps1 --ssh root@SERVER --discover   Discovered inventory
  .\p2s-harden.ps1 --ssh root@SERVER --scan-webshells   PHP file indicator scan
  .\p2s-harden.ps1 --ssh root@SERVER --dry-run    Preview changes
  .\p2s-harden.ps1 --ssh root@SERVER --fix        Apply bounded fixes

  --lang en|de                 Output language (default: en)
  --root /path                 Limit filesystem scope
  --site URL=DOCUMENT_ROOT     Explicit virtual host; repeatable
  --web-user USER              Additional FPM user
  --nginx-config /path         Custom Nginx main configuration
  --runtime-dir /path          Review a known upload/cache directory separately
  --max-sites COUNT            Limit automatic HTTP mappings
  --max-paths COUNT            Limit filesystem traversal
  --walk-seconds SECONDS       Audit: 10s; webshell scan: 120s; scan-only 0 disables root timer
  --scan-file-seconds N        Independent webshell file timer (default 2s)
  --no-nice                  Skip lowering scan CPU/I/O priority
  --baseline FILE             Reviewed JSON: exact path/hash/indicator acceptance
  --write-baseline-draft FILE  Create a new private draft; no entries approved
  --max-http-probes COUNT      Limit HTTP requests
  --protect-dir /path          Protect one directory; non-recursive
  --rollback [--backup-id ID]  Restore a transaction
  --json --verbose --no-auto --no-progress      Same options as the Bash CLI
  --redact                    Omit host details from a read-only shareable report
  --scan-file-bytes N          PHP parsing byte limit; larger files streamed (2097152)
  --scan-total-bytes N         Webshell scan: bytes per root (268435456)
  --yes --fail-on complete|open|review --ignore ID     Approval and automation policy

The Linux target requires Python 3.8+. Missing helpers are explained individually.
The default mode is read-only. No installer or configuration file is needed.
'@
                    exit 0
                }
                @'
p2s-harden 2.3.0-dev.5 - Windows -> Linux, direkt per OpenSSH

  .\p2s-harden.ps1 --ssh root@SERVER              Erkennen und prüfen
  .\p2s-harden.ps1 --ssh root@SERVER --doctor     Voraussetzungen erklären
  .\p2s-harden.ps1 --ssh root@SERVER --discover   Erkanntes Inventar
  .\p2s-harden.ps1 --ssh root@SERVER --scan-webshells   PHP-Datei-Indikatoren
  .\p2s-harden.ps1 --ssh root@SERVER --dry-run    Fixes anzeigen
  .\p2s-harden.ps1 --ssh root@SERVER --fix        Begrenzte Fixes anwenden

  --lang en|de                 Ausgabesprache (Standard: en)
  --root /pfad                 Dateisystem-Prüfbereich einschränken
  --site URL=DOKUMENTWURZEL    Expliziter vHost; wiederholbar
  --web-user BENUTZER          Zusätzlicher FPM-Benutzer
  --nginx-config /pfad         Abweichende Nginx-Hauptkonfiguration
  --runtime-dir /pfad          Bekanntes Upload-/Cache-Verzeichnis gesondert bewerten
  --max-sites ANZAHL           Automatische HTTP-Zuordnungen begrenzen
  --max-paths ANZAHL           Dateisystem-Suchlauf begrenzen
  --walk-seconds SEKUNDEN      Audit: 10s; Webshell-Suche: 120s; nur Suche: 0 ohne Wurzeltimer
  --scan-file-seconds N        Eigenes Webshell-Zeitlimit je Datei (Standard 2s)
  --no-nice                  Scan-Priorität nicht absenken
  --baseline DATEI            Geprüfte JSON: exakter Pfad/Hash/Indikator
  --write-baseline-draft DATEI  Privaten Entwurf erstellen; keine Freigaben
  --max-http-probes ANZAHL     HTTP-Anfragen begrenzen
  --protect-dir /pfad          Ein Verzeichnis schützen; nicht rekursiv
  --rollback [--backup-id ID]  Eine Transaktion zurücknehmen
  --json --verbose --no-auto --no-progress      Wie bei der Bash-Datei
  --redact                    Teilbarer Prüfbericht ohne private Hostdetails
  --scan-file-bytes N          PHP-Parserlimit; größere Dateien gestreamt (2097152)
  --scan-total-bytes N         Webshell-Suche: Bytes je Wurzel (268435456)
  --yes --fail-on complete|open|review --ignore ID     Freigabe und Automatisierungsregeln

Das Linux-Ziel braucht Python 3.8+. Fehlende Helfer werden einzeln erklärt.
Standard ist eine Prüfung. Kein Installer und keine Konfigurationsdatei.
'@
                exit 0
            }
            '--version' { 'p2s-harden 2.3.0-dev.5'; exit 0 }
            default { $cliArguments.Add($argument) }
        }
    }
    if ($null -eq $target) { throw (Message 'Specify a Linux target: .\p2s-harden.ps1 --ssh root@SERVER. Use p2s-harden.sh for local Linux checks.' 'Linux-Ziel angeben: .\p2s-harden.ps1 --ssh root@SERVER. Für lokale Linux-Prüfungen p2s-harden.sh verwenden.') }
    $ssh = $env:SSH_BIN
    if (-not $ssh) {
        $native = Join-Path $env:SystemRoot 'System32\OpenSSH\ssh.exe'
        if (Test-Path -LiteralPath $native) { $ssh = $native }
        else {
            $found = Get-Command ssh.exe -ErrorAction SilentlyContinue
            if ($found) { $ssh = $found.Source }
        }
    }
    if (-not $ssh) { throw (Message 'OpenSSH client is missing. Enable the OpenSSH Client in Windows Optional Features or set SSH_BIN.' 'OpenSSH-Client fehlt. In Windows unter Optionale Features den OpenSSH-Client bereitstellen oder SSH_BIN setzen.') }
    $bootstrap = @'
__BOOTSTRAP__
'@
    $jsonFlag = if ($jsonMode) { '1' } else { '0' }
    $remote = $bootstrap + "; bootstrap $jsonFlag $lang || exit 2; exec python3 -B -"
    if (-not [Console]::IsErrorRedirected) { $cliArguments.Add('--progress') }
    foreach ($value in $cliArguments) { $remote += ' ' + (Quote-Posix $value) }
    $batch = if ([Console]::IsInputRedirected) { 'yes' } else { 'no' }
    $nativeArgs = @('-T', '-o', "BatchMode=$batch", '-o', 'ConnectTimeout=15',
                    '-o', 'ServerAliveInterval=10', '-o', 'ServerAliveCountMax=3', '--', $target, $remote)
    $info = New-Object System.Diagnostics.ProcessStartInfo
    $info.FileName = $ssh
    $info.Arguments = ($nativeArgs | ForEach-Object { Quote-Native $_ }) -join ' '
    $info.UseShellExecute = $false
    $info.CreateNoWindow = $true
    $info.RedirectStandardInput = $true
    $process = New-Object System.Diagnostics.Process
    $process.StartInfo = $info
    [void]$process.Start()
    try {
        $engineBytes = [Convert]::FromBase64String('__ENGINE_BASE64__')
        $process.StandardInput.BaseStream.Write($engineBytes, 0, $engineBytes.Length)
        $process.StandardInput.BaseStream.Flush()
    } catch [System.IO.IOException] { } # Remote bootstrap may finish before reading stdin.
    finally { $process.StandardInput.BaseStream.Close() }
    $process.WaitForExit()
    $result = $process.ExitCode
    $process.Dispose()
    if ($result -eq 255) {
        Write-Failure 'SSH' (Message 'Target unreachable or login failed; check your existing SSH access and retry.' 'Ziel nicht erreichbar oder Anmeldung fehlgeschlagen; vorhandenen SSH-Zugang prüfen und erneut ausführen.')
        exit 2
    }
    exit $result
} catch {
    Write-Failure (Message 'Prerequisites' 'Voraussetzungen') $_.Exception.Message
    exit 2
}
